# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fantasy_league
# Redis (необязательно, но рекомендуется в production: общий storage rate limit между workers)
# REDIS_URL=redis://localhost:6379/0
# Enable only for the Render deployment where Cloudflare overwrites this header.
TRUST_CF_CONNECTING_IP=false
# Intervals.icu (API-ключи у каждого пользователя свои)
INTERVALS_API_URL=https://intervals.icu/api/v1
# Секреты: сгенерируй командами из README, значения должны быть РАЗНЫЕ
JWT_SECRET=
ENCRYPTION_KEY=
# id пользователей-админов через запятую
ADMIN_USER_IDS=
# Разрешённые frontend origins, разделённые запятыми (без wildcard)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://endurance-fantasy-league.vercel.app
# Граница начисления новых квестов; дата начала недели (понедельник)
XP_QUESTS_ACTIVATION_DATE=2026-10-12
# Движок XP и production на Render
XP_ENGINE=v6
APP_ENV=development
